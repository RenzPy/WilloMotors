# Copy to .env, fill in, then:  chmod 600 .env
#
# Load it into a shell session with:
#   set -a; source .env; set +a
# systemd reads this file format directly (EnvironmentFile=).

# --- Telegram (required for alerts and for --listen) ---------------------
# Bot token from @BotFather
TG_TOKEN=
# Your chat id: message the bot, then open
#   https://api.telegram.org/bot<TOKEN>/getUpdates
TG_CHAT=

# --- Gemini (optional) ---------------------------------------------------
# Free key: https://aistudio.google.com/apikey
# Without it the regex parser is used and nothing breaks.
GEMINI_API_KEY=
# The model is chosen per task from what your key can actually use:
#   GEMINI_MODEL       photo checks and verdicts (flash: 20 a day on the free tier)
#   GEMINI_MODEL_BULK  reading pasted adverts   (flash-lite: 500 a day)
# "auto" is recommended for both. Every change is announced on Telegram.
GEMINI_MODEL=auto
GEMINI_MODEL_BULK=auto
